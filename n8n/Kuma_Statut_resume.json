    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst configItem = items.find(i => i.json.publicGroupList)?.json;\nconst heartbeatItem = items.find(i => i.json.uptimeList || i.json.heartbeatList)?.json;\n\nconst idToName = {};\nfor (const group of configItem?.publicGroupList || []) {\n  for (const m of group.monitorList || []) {\n    idToName[m.id] = m.name;\n  }\n}\n\nconst uptimeList = heartbeatItem?.uptimeList || {};\nconst heartbeatList = heartbeatItem?.heartbeatList || {};\n\nconst monitors = Object.keys(idToName).map(id => {\n  const uptime = uptimeList[`${id}_24`];\n  const hb = heartbeatList[id] || [];\n  const last = hb[hb.length - 1];\n  return {\n    name: idToName[id],\n    status: last ? (last.status === 1 ? \"up\" : \"down\") : \"unknown\",\n    uptime24h: uptime != null ? Math.round(uptime * 1000) / 10 : null,\n  };\n});\n\nreturn [{ json: { monitors } }];"
      },
      "type": "n8n-nodes-base.code",
